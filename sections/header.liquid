<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
<link
  rel="stylesheet"
  href="{{ 'component-cart-notification.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>

{%- if settings.predictive_search_enabled -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

<style>
    .bouzian-header-wrapper {
      position: relative;
      z-index: 50;
    }

    .bouzian-header {
      color: rgb(var(--color-foreground));
    }

    .bouzian-main {
      max-width: var(--page-width);
      margin: 0 auto;
      padding: {{ section.settings.desktop_padding_top }}px 5rem {{ section.settings.desktop_padding_bottom }}px;
    }
    .bouzian-menu__link {
    color: currentColor;
    text-decoration: none;
    font-size: {{ section.settings.nav_text_size }}px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    min-height: {{ section.settings.nav_height }}px;
  }

  .bouzian-menu__caret {
    width: 1.1rem;
    height: 1.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
    color: currentColor;
    transition: transform 0.18s ease;
  }

  .bouzian-menu__caret svg {
    width: 100%;
    height: 100%;
    display: block;
    fill: currentColor;
  }

  .bouzian-menu__item:hover .bouzian-menu__caret {
    transform: rotate(180deg);
  }

    .bouzian-main__row {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: start;
      gap: 2.4rem;
    }

    .bouzian-logo {
      display: inline-flex;
      align-items: center;
      text-decoration: none;
      color: currentColor;
      width: fit-content;
    }

    .bouzian-logo img {
      display: block;
      width: auto;
      max-width: {{ section.settings.logo_max_width }}px;
      height: auto;
    }

    .bouzian-logo__text {
      display: flex;
      flex-direction: column;
      line-height: 1;
      color: currentColor;
    }

    .bouzian-logo__main {
      font-size: {{ section.settings.fallback_logo_size }}px;
      font-weight: 900;
      letter-spacing: -0.05em;
      text-transform: uppercase;
    }

    .bouzian-logo__sub {
      margin-top: 0.5rem;
      font-size: 1.2rem;
      font-weight: 600;
      letter-spacing: 0.55em;
      text-transform: uppercase;
      padding-left: 0.4rem;
    }

    .bouzian-actions {
      display: flex;
      align-items: flex-start;
      gap: {{ section.settings.action_gap }}px;
      padding-top: 0.4rem;
    }

    .bouzian-action {
      color: currentColor;
      text-decoration: none;
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      gap: 0.7rem;
      font-size: {{ section.settings.action_text_size }}px;
      font-weight: 800;
      line-height: 1;
      text-transform: uppercase;
      position: relative;
    }

    .bouzian-action svg {
      width: {{ section.settings.icon_size }}px;
      height: {{ section.settings.icon_size }}px;
      color: currentColor;
    }

    .bouzian-cart-count {
      position: absolute;
      top: -0.8rem;
      right: 1.2rem;
      min-width: 1.7rem;
      height: 1.7rem;
      border-radius: 999px;
      background: rgb(var(--color-foreground));
      color: rgb(var(--color-background));
      font-size: 1rem;
      display: grid;
      place-items: center;
      padding: 0 0.4rem;
    }

    .bouzian-nav-shell {
      max-width: var(--page-width);
      margin: 0 auto;
      padding: 0 5rem;
    }

    .bouzian-nav {
      border-top: 0.1rem solid rgba(var(--color-foreground), {{ section.settings.border_opacity | divided_by: 100.0 }});
      border-bottom: 0.1rem solid rgba(var(--color-foreground), {{ section.settings.border_opacity | divided_by: 100.0 }});
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      min-height: {{ section.settings.nav_height }}px;
    }

    .bouzian-category-trigger {
      color: currentColor;
      text-decoration: none;
      font-size: {{ section.settings.nav_text_size }}px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: -0.01em;
      display: inline-flex;
      align-items: center;
      gap: 1.4rem;
      width: fit-content;
    }

    .bouzian-category-trigger span {
      font-size: 2.8rem;
      line-height: 0;
      transform: translateY(-0.1rem);
    }

    .bouzian-menu {
      display: flex;
      align-items: center;
      gap: {{ section.settings.menu_gap }}px;
    }

    .bouzian-menu__item {
      position: relative;
    }

    .bouzian-menu__link {
      color: currentColor;
      text-decoration: none;
      font-size: {{ section.settings.nav_text_size }}px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: -0.02em;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      min-height: {{ section.settings.nav_height }}px;
    }

    .bouzian-menu__link:hover,
    .bouzian-menu__item:hover > .bouzian-menu__link {
      opacity: 0.65;
    }

    .bouzian-menu__chevron {
      color: currentColor;
      font-size: 1.4rem;
      line-height: 1;
    }

    .bouzian-dropdown {
      position: absolute;
      top: 100%;
      left: 0;
      min-width: 21rem;
      background: rgb(var(--color-background));
      color: rgb(var(--color-foreground));
      padding: 1.8rem 2.2rem;
      box-shadow: 0 1.6rem 3rem rgba(var(--color-foreground), 0.08);
      opacity: 0;
      visibility: hidden;
      transform: translateY(0.8rem);
      transition: all 0.18s ease;
      z-index: 30;
    }

    .bouzian-menu__item:hover .bouzian-dropdown {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .bouzian-dropdown a {
      display: block;
      color: currentColor;
      text-decoration: none;
      font-size: 1.5rem;
      font-weight: 600;
      padding: 0.7rem 0;
      line-height: 1.2;
    }

    .bouzian-dropdown a:hover {
      opacity: 0.65;
    }

    .bouzian-mobile {
      display: none;
    }

    .bouzian-mobile__bar {
      max-width: var(--page-width);
      margin: 0 auto;
      padding: {{ section.settings.mobile_padding_y }}px 2rem;
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 1.6rem;
    }

    .bouzian-mobile__toggle {
      border: 0;
      background: transparent;
      padding: 0;
      color: currentColor;
      cursor: pointer;
      display: flex;
      align-items: center;
    }

    .bouzian-mobile__toggle svg {
      width: 2.8rem;
      height: 2.8rem;
    }

    .bouzian-mobile__logo {
      justify-content: center;
    }

    .bouzian-mobile__logo img {
      max-width: {{ section.settings.mobile_logo_max_width }}px;
    }

    .bouzian-mobile__logo .bouzian-logo__main {
      font-size: 2.5rem;
    }

    .bouzian-mobile__logo .bouzian-logo__sub {
      font-size: 0.9rem;
    }

    .bouzian-mobile__icons {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 1.4rem;
    }

    .bouzian-mobile__icons .bouzian-action {
      font-size: 0;
      gap: 0;
    }

    .bouzian-drawer {
      display: none;
      background: rgb(var(--color-background));
      color: rgb(var(--color-foreground));
      border-top: 0.1rem solid rgba(var(--color-foreground), {{ section.settings.border_opacity | divided_by: 100.0 }});
      padding: 1.8rem 2rem 2.4rem;
    }

    .bouzian-drawer.is-open {
      display: block;
    }

    .bouzian-drawer__category {
      display: flex;
      text-decoration: none;
      color: currentColor;
      text-transform: uppercase;
      font-weight: 900;
      font-size: 1.5rem;
      padding: 1.4rem 0;
      border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.25);
    }

    .bouzian-drawer__menu {
      margin-top: 1rem;
    }

    .bouzian-drawer__link {
      display: block;
      color: currentColor;
      text-decoration: none;
      text-transform: uppercase;
      font-weight: 900;
      font-size: 1.6rem;
      padding: 1.4rem 0;
      border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.2);
    }

    .bouzian-drawer__sublink {
      display: block;
      color: currentColor;
      text-decoration: none;
      font-size: 1.5rem;
      padding: 0.8rem 0 0.8rem 1.8rem;
      opacity: 0.75;
    }

    @media screen and (max-width: 989px) {
      .bouzian-desktop {
        display: none;
      }

      .bouzian-mobile {
        display: block;
      }
    }

    @media screen and (max-width: 480px) {
      .bouzian-mobile__bar {
        padding-left: 1.6rem;
        padding-right: 1.6rem;
        gap: 1rem;
      }

      .bouzian-mobile__logo img {
        max-width: {{ section.settings.mobile_logo_small_max_width }}px;
      }

      .bouzian-mobile__logo .bouzian-logo__main {
        font-size: 2.1rem;
      }

      .bouzian-mobile__logo .bouzian-logo__sub {
        font-size: 0.8rem;
        letter-spacing: 0.4em;
      }
    }
</style>

{%- liquid
  assign header_tag = 'div'

  if section.settings.sticky_header_type != 'none'
    assign header_tag = 'sticky-header'
  endif
-%}

<{{ header_tag }}
  {% if header_tag == 'sticky-header' %}
    data-sticky-type="{{ section.settings.sticky_header_type }}"
  {% endif %}
  class="bouzian-header-wrapper color-{{ section.settings.color_scheme }} gradient"
>
  <div class="bouzian-header">
    <div class="bouzian-desktop">
      <header class="bouzian-main">
        <div class="bouzian-main__row">
          <a href="{{ routes.root_url }}" class="bouzian-logo">
            {%- if settings.logo != blank -%}
              {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
              {{
                settings.logo
                | image_url: width: 600
                | image_tag: alt: logo_alt, loading: 'eager', class: 'bouzian-logo__img'
              }}
            {%- else -%}
              <span class="bouzian-logo__text">
                <span class="bouzian-logo__main">{{ shop.name }}</span>
                <span class="bouzian-logo__sub">{{ section.settings.logo_subtitle }}</span>
              </span>
            {%- endif -%}
          </a>

          <div class="bouzian-actions">
            {%- if shop.customer_accounts_enabled -%}
              <a
                href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
                class="bouzian-action"
                rel="nofollow"
              >
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 12.5c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4Z" stroke="currentColor" stroke-width="1.7"/>
                  <path d="M4.75 20c.8-3.25 3.45-5.25 7.25-5.25s6.45 2 7.25 5.25" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                </svg>
                <span>{{ section.settings.account_label }}</span>
              </a>
            {%- endif -%}

            <a href="{{ routes.cart_url }}" class="bouzian-action" id="cart-icon-bubble">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M7 7h13l-1.4 7.2a2 2 0 0 1-1.96 1.6H9.15a2 2 0 0 1-1.96-1.62L5.5 4.8H3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M10 20.2h.01M17 20.2h.01" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
              </svg>
              <span>{{ section.settings.cart_label }}</span>

              {%- if cart != empty -%}
                <span class="bouzian-cart-count" aria-hidden="true">{{ cart.item_count }}</span>
              {%- endif -%}
            </a>
          </div>
        </div>
      </header>

      <nav class="bouzian-nav-shell" aria-label="Main navigation">
        <div class="bouzian-nav">
          <a href="{{ section.settings.category_link }}" class="bouzian-category-trigger">
            {{ section.settings.category_label }}
            <span>→</span>
          </a>

          <div class="bouzian-menu">
            {%- if section.settings.menu != blank -%}
              {%- for link in section.settings.menu.links -%}
                <div class="bouzian-menu__item">
                  <a href="{{ link.url }}" class="bouzian-menu__link">
                    {{ link.title }}
                    {%- if link.links != blank -%}
                      <span class="bouzian-menu__caret svg-wrapper" aria-hidden="true">
                        {{- 'icon-caret.svg' | inline_asset_content -}}
                      </span>
                    {%- endif -%}
                  </a>

                  {%- if link.links != blank -%}
                    <div class="bouzian-dropdown">
                      {%- for childlink in link.links -%}
                        <a href="{{ childlink.url }}">{{ childlink.title }}</a>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
      </nav>
    </div>

    <div class="bouzian-mobile">
      <div class="bouzian-mobile__bar">
        <button
          class="bouzian-mobile__toggle"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          data-bouzian-menu-toggle
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>

        <a href="{{ routes.root_url }}" class="bouzian-logo bouzian-mobile__logo">
          {%- if settings.logo != blank -%}
            {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
            {{
              settings.logo
              | image_url: width: 360
              | image_tag: alt: logo_alt, loading: 'eager', class: 'bouzian-logo__img'
            }}
          {%- else -%}
            <span class="bouzian-logo__text">
              <span class="bouzian-logo__main">{{ shop.name }}</span>
              <span class="bouzian-logo__sub">{{ section.settings.logo_subtitle }}</span>
            </span>
          {%- endif -%}
        </a>

        <div class="bouzian-mobile__icons">
          {%- if shop.customer_accounts_enabled -%}
            <a
              href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
              class="bouzian-action"
              rel="nofollow"
              aria-label="{{ section.settings.account_label }}"
            >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 12.5c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4Z" stroke="currentColor" stroke-width="1.7"/>
                <path d="M4.75 20c.8-3.25 3.45-5.25 7.25-5.25s6.45 2 7.25 5.25" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
              </svg>
              <span>{{ section.settings.account_label }}</span>
            </a>
          {%- endif -%}

          <a href="{{ routes.cart_url }}" class="bouzian-action" aria-label="{{ section.settings.cart_label }}">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M7 7h13l-1.4 7.2a2 2 0 0 1-1.96 1.6H9.15a2 2 0 0 1-1.96-1.62L5.5 4.8H3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M10 20.2h.01M17 20.2h.01" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
            </svg>

            {%- if cart != empty -%}
              <span class="bouzian-cart-count" aria-hidden="true">{{ cart.item_count }}</span>
            {%- endif -%}
          </a>
        </div>
      </div>

      <div class="bouzian-drawer" data-bouzian-drawer>
        <a href="{{ section.settings.category_link }}" class="bouzian-drawer__category">
          {{ section.settings.category_label }} →
        </a>

        <div class="bouzian-drawer__menu">
          {%- if section.settings.menu != blank -%}
            {%- for link in section.settings.menu.links -%}
              <a href="{{ link.url }}" class="bouzian-drawer__link">{{ link.title }}</a>

              {%- if link.links != blank -%}
                {%- for childlink in link.links -%}
                  <a href="{{ childlink.url }}" class="bouzian-drawer__sublink">{{ childlink.title }}</a>
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</{{ header_tag }}>

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification', color_scheme: section.settings.color_scheme, desktop_menu_type: 'dropdown' -%}
{%- endif -%}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var toggle = document.querySelector('[data-bouzian-menu-toggle]');
    var drawer = document.querySelector('[data-bouzian-drawer]');

    if (!toggle || !drawer) return;

    toggle.addEventListener('click', function () {
      var isOpen = drawer.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
  });
</script>

{% javascript %}
  class StickyHeader extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.header = document.querySelector('.section-header');
      this.headerIsAlwaysSticky =
        this.getAttribute('data-sticky-type') === 'always' ||
        this.getAttribute('data-sticky-type') === 'reduce-logo-size';
      this.headerBounds = {};

      this.setHeaderHeight();

      window.matchMedia('(max-width: 990px)').addEventListener('change', this.setHeaderHeight.bind(this));

      if (this.headerIsAlwaysSticky && this.header) {
        this.header.classList.add('shopify-section-header-sticky');
      }

      this.currentScrollTop = 0;
      this.preventReveal = false;
      this.predictiveSearch = this.querySelector('predictive-search');

      this.onScrollHandler = this.onScroll.bind(this);
      this.hideHeaderOnScrollUp = () => (this.preventReveal = true);

      this.addEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.addEventListener('scroll', this.onScrollHandler, false);

      this.createObserver();
    }

    setHeaderHeight() {
      if (!this.header) return;
      document.documentElement.style.setProperty('--header-height', `${this.header.offsetHeight}px`);
    }

    disconnectedCallback() {
      this.removeEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.removeEventListener('scroll', this.onScrollHandler);
    }

    createObserver() {
      if (!this.header) return;

      let observer = new IntersectionObserver((entries, observer) => {
        this.headerBounds = entries[0].intersectionRect;
        observer.disconnect();
      });

      observer.observe(this.header);
    }

    onScroll() {
      if (!this.header) return;

      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (this.predictiveSearch && this.predictiveSearch.isOpen) return;

      if (scrollTop > this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (this.preventHide) return;
        requestAnimationFrame(this.hide.bind(this));
      } else if (scrollTop < this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (!this.preventReveal) {
          requestAnimationFrame(this.reveal.bind(this));
        } else {
          window.clearTimeout(this.isScrolling);

          this.isScrolling = setTimeout(() => {
            this.preventReveal = false;
          }, 66);

          requestAnimationFrame(this.hide.bind(this));
        }
      } else if (scrollTop <= this.headerBounds.top) {
        this.header.classList.remove('scrolled-past-header');
        requestAnimationFrame(this.reset.bind(this));
      }

      this.currentScrollTop = scrollTop;
    }

    hide() {
      if (this.headerIsAlwaysSticky || !this.header) return;
      this.header.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky');
    }

    reveal() {
      if (this.headerIsAlwaysSticky || !this.header) return;
      this.header.classList.add('shopify-section-header-sticky', 'animate');
      this.header.classList.remove('shopify-section-header-hidden');
    }

    reset() {
      if (this.headerIsAlwaysSticky || !this.header) return;
      this.header.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
    }
  }

  if (!customElements.get('sticky-header')) {
    customElements.define('sticky-header', StickyHeader);
  }
{% endjavascript %}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Bouzian Header",
  "class": "section-header",
  "settings": [
